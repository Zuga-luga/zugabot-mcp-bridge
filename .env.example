# Copy to .env and fill in, OR (more usefully) export these into the
# environment that launches the bridge.
#
# IMPORTANT: this bridge does NOT load .env files. There is no python-dotenv
# dependency and no loader in the code -- it reads os.environ directly. A .env
# file sitting next to the script does nothing on its own. It must be exported
# by your shell, your MCP client config, or a process manager.
#
# In Claude Code, the usual place is the `env` block of the server's entry in
# .mcp.json. Note that a `${VAR}` placeholder there is only useful if VAR
# actually exists in the environment Claude Code was launched from; if it
# doesn't, the literal string "${VAR}" is what reaches this process, and every
# authenticated call 401s while list_zugabot_skills keeps working (the Agent
# Card is unauthenticated). The bridge warns loudly at startup when it sees
# that exact shape.

# Base URL of the host actually running the Zugabot A2A server.
# NOT the product website -- https://zugabot.ai serves an HTML frontend, not
# the A2A endpoint, and will fail with a non-JSON response error.
ZUGABOT_A2A_URL=http://192.168.1.200:8000

# Bearer credential, formatted client_id:secret. Required.
# Must match the value the Zugabot backend checks server-side.
ZUGABOT_A2A_TOKEN=your_client_id:your_secret
